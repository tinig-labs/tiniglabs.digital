# Copy to .env.local for local development. In Azure, set these as App Service
# app settings (keep ACS_CONNECTION_STRING in Key Vault).

# Azure Communication Services resource connection string (Settings > Keys)
ACS_CONNECTION_STRING=endpoint=https://<resource>.communication.azure.com/;accesskey=<key>

# Sender + inbox for each form. Both must be MailFrom addresses on the ACS-verified domain.
WAITLIST_EMAIL=waitlist@tiniglabs.digital
BLOG_EMAIL=subscribe@tiniglabs.digital

# Canonical site origin, read at build time
NEXT_PUBLIC_SITE_URL=https://tiniglabs.digital
